# Copy this file to .streamlit/secrets.toml and set real values.
# secrets.toml itself is gitignored -- never commit real secrets.
#
# On Streamlit Community Cloud, don't upload this file at all: open the
# app's dashboard, go to Settings -> Secrets, and paste the same lines
# there instead.

app_password = "change-me"

# Optional. Only needed to enable the AI fallback for a bank statement whose
# format the rule-based parser doesn't recognize (see core/llm_extractor.py
# and README.md). Without this key, an unrecognized statement is just
# flagged for manual review instead -- nothing else in the app is affected.
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional. Only matters together with ANTHROPIC_API_KEY above: without it,
# a bank profile the AI fallback learns still works, but only until the next
# deploy (Streamlit Cloud's filesystem is ephemeral). With it, a learned
# profile is committed straight back to bank_profiles/ in this repo's main
# branch, so it survives every future deploy. A fine-grained GitHub Personal
# Access Token scoped to ONLY this repository, with "Contents: Read and
# write" permission and nothing else -- see README.md for exact setup steps.
# GITHUB_TOKEN = "github_pat_..."
