# Copy this file to .streamlit/secrets.toml and set real values.
# secrets.toml itself is gitignored -- never commit real secrets.
#
# On Streamlit Community Cloud, don't upload this file at all: open the
# app's dashboard, go to Settings -> Secrets, and paste the same lines
# there instead.

app_password = "change-me"

# Required. The AI reads every uploaded file (see core/ai_reader.py).
# Without it, the app shows a clear message and the Start button is disabled.
OPENAI_API_KEY = "sk-..."

# Recommended. Where every client's work is saved (a free Supabase project
# works). Use the "Session pooler" connection string from Supabase's Connect
# button, with the database password in place of [YOUR-PASSWORD]. Use a
# password made of letters and numbers only: symbols like # ? / @ break the
# string. Without this line the app still works, but work is lost when the
# browser tab closes, and the sidebar says so.
DATABASE_URL = "postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
